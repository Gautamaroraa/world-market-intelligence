# All integrations are optional in the starter build.
GDELT_QUERY=(India OR "Indian economy" OR RBI OR NSE) (stocks OR earnings OR inflation OR rates OR oil OR policy OR exports)
GDELT_MAX_RECORDS=75
REQUEST_TIMEOUT=25
MINIMUM_SOURCE_COUNT=1

# Future connectors; store real values in GitHub Actions secrets, never here.
ZERODHA_API_KEY=
ZERODHA_ACCESS_TOKEN=
OPENAI_API_KEY=
